{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-analysis-requests",
      "schedule": "10 9 * * 1-5"
    },
    {
      "path": "/api/cron/process-paper-simulations",
      "schedule": "25 9 * * 1-5"
    },
    {
      "path": "/api/cron/process-analysis-outcomes",
      "schedule": "10 10 * * 1-5"
    },
    {
      "path": "/api/cron/run-harness",
      "schedule": "40 7 * * 1-5"
    },
    {
      "path": "/api/cron/process-harness-outcomes",
      "schedule": "20 10 * * 1-5"
    },
    {
      "path": "/api/cron/process-subscription-renewals",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron/notify-harness-issue?slot=morning",
      "schedule": "56 22 * * 0-4"
    },
    {
      "path": "/api/cron/notify-harness-issue?slot=midday",
      "schedule": "25 1 * * 1-5"
    },
    {
      "path": "/api/cron/notify-exits",
      "schedule": "35 1 * * 1-5"
    },
    {
      "path": "/api/cron/notify-outcomes",
      "schedule": "40 10 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/analyses",
      "destination": "/api/index.py"
    },
    {
      "source": "/analyses/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/outcomes",
      "destination": "/api/index.py"
    },
    {
      "source": "/harness",
      "destination": "/api/index.py"
    },
    {
      "source": "/harness/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/member",
      "destination": "/api/index.py"
    },
    {
      "source": "/mypage",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin",
      "destination": "/api/index.py"
    },
    {
      "source": "/privacy",
      "destination": "/api/index.py"
    },
    {
      "source": "/terms",
      "destination": "/api/index.py"
    },
    {
      "source": "/pricing",
      "destination": "/api/index.py"
    },
    {
      "source": "/billing",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin/members",
      "destination": "/api/index.py"
    },
    {
      "source": "/disclaimer",
      "destination": "/api/index.py"
    },
    {
      "source": "/features/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/stocks",
      "destination": "/api/index.py"
    },
    {
      "source": "/stocks/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.py"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index.py"
    },
    {
      "source": "/og/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/indexnow/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/favicon.svg",
      "destination": "/api/index.py"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/api/index.py"
    },
    {
      "source": "/icon-:size.png",
      "destination": "/api/index.py"
    },
    {
      "source": "/site.webmanifest",
      "destination": "/api/index.py"
    },
    {
      "source": "/:verification(google[a-z0-9]+\\.html|naver[a-z0-9]+\\.html|BingSiteAuth\\.xml|yandex_[a-z0-9]+\\.html)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/index.py"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index.py"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    }
  ]
}
