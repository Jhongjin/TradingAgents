{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-analysis-requests",
      "schedule": "10 9 * * 1-5"
    },
    {
      "path": "/api/cron/process-analysis-outcomes",
      "schedule": "10 10 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/analyses",
      "destination": "/api/index.py"
    },
    {
      "source": "/analyses/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/outcomes",
      "destination": "/api/index.py"
    },
    {
      "source": "/member",
      "destination": "/api/index.py"
    },
    {
      "source": "/mypage",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin",
      "destination": "/api/index.py"
    },
    {
      "source": "/features/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/stocks",
      "destination": "/api/index.py"
    },
    {
      "source": "/stocks/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.py"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/index.py"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index.py"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    }
  ]
}
