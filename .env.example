# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Korean market data
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KRX_API_KEY=
# Alias accepted by pykrx-openapi wrapper.
KRX_OPENAPI_KEY=

# Korea Investment & Securities (KIS) paper/live credentials.
# KIS_ACCOUNT_NO is usually the first 8 digits of the account.
# KIS_ACCOUNT_PRODUCT_CODE is usually the 2-digit account product code, e.g. 01.
KIS_IS_PAPER=true
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
# Common aliases also accepted: KIS_CANO, KIS_ACNT_PRDT_CD.
# KIS issues a separate app key/account for 모의투자. When KIS_IS_PAPER=true these
# take precedence so real and virtual credentials can coexist.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=

# Optional database for future dashboards/automation. Not required for CLI MVP.
DATABASE_URL=
# SQLAlchemy Postgres driver for DATABASE_URL. pg8000 is pure Python and Vercel-friendly.
TRADINGAGENTS_POSTGRES_DRIVER=pg8000
TRADINGAGENTS_STORAGE_ENABLED=false
# Set true only for local/dev databases. Production Supabase should use migrations.
TRADINGAGENTS_STORAGE_CREATE_SCHEMA=false
TRADINGAGENTS_ANALYSIS_VISIBILITY=public
# Optional Supabase auth.users.id owner UUID for private/server-owned runs.
TRADINGAGENTS_ANALYSIS_USER_ID=

# Optional read-only API deployment controls
# SUPABASE_URL can also reuse NEXT_PUBLIC_SUPABASE_URL in Vercel deployments.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY can be used instead of SUPABASE_ANON_KEY for newer Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TRADINGAGENTS_API_CORS_ORIGINS=
TRADINGAGENTS_API_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
TRADINGAGENTS_API_PUBLIC_CACHE_SECONDS=300
TRADINGAGENTS_API_MAX_PRICE_TICKERS=20
TRADINGAGENTS_API_MAX_ANALYSIS_FEED_LIMIT=50
TRADINGAGENTS_API_DOCS_ENABLED=true
TRADINGAGENTS_AUTH_TIMEOUT_SECONDS=5
TRADINGAGENTS_SITE_BASE_URL=
TRADINGAGENTS_SITEMAP_TICKERS=005930,000660,035420,035720,051910,005380,068270,005490
TRADINGAGENTS_SITEMAP_MAX_ANALYSIS_TICKERS=200
# Public chart vendor: keep pykrx by default. Use auto to try approved KRX
# first only for short ranges and fall back to pykrx, or krx for explicit
# KRX-only diagnostics.
TRADINGAGENTS_CHART_DATA_VENDOR=pykrx
# KRX Open API daily trade data is date-based. Keep synchronous public chart
# windows short until KRX latency, quota, and caching are measured.
TRADINGAGENTS_KRX_CHART_MAX_DAYS=14
TRADINGAGENTS_ADSENSE_PUBLISHER_ID=
# Optional full ads.txt override. Use \n between lines when setting as a single env var.
TRADINGAGENTS_ADS_TXT=
TRADINGAGENTS_WORKER_TOKEN=
TRADINGAGENTS_WORKER_MAX_REQUESTS=1
TRADINGAGENTS_WORKER_CRON_LIMIT=1
# Outcome evaluation is market-data work, not an LLM analysis run, so it has a
# separate limit from the expensive analysis request worker.
TRADINGAGENTS_OUTCOME_WORKER_MAX_RUNS=20
TRADINGAGENTS_OUTCOME_WORKER_CRON_LIMIT=5
# Vercel Cron can send this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Keep false unless the API sits behind a trusted auth layer that sets
# X-TradingAgents-User-Id to the authenticated Supabase user UUID.
TRADINGAGENTS_API_TRUST_MEMBER_USER_HEADER=false

# Optional HTTPS trust configuration for corporate Windows environments.
# Prefer a trusted CA bundle path instead of disabling verification.
TRADINGAGENTS_HTTP_CA_BUNDLE=
# TRADINGAGENTS_HTTP_VERIFY_SSL=true
# On Windows, use the OS certificate store through the optional truststore
# package. This keeps TLS verification on while handling local security roots.
TRADINGAGENTS_HTTP_USE_SYSTEM_CERTS=true
# Optional local doctor probe. Leave false for quick/offline checks; set true
# when validating KRX service-level approval without printing secrets.
TRADINGAGENTS_DOCTOR_CHECK_KRX_ONLINE=false
TRADINGAGENTS_DOCTOR_KRX_PROBE_DATE=

# Optional TradingAgents local paths
TRADINGAGENTS_RESULTS_DIR=
TRADINGAGENTS_CACHE_DIR=
TRADINGAGENTS_MEMORY_LOG_PATH=

# Execution safety defaults for this fork
# Keep live trading disabled unless a broker adapter, credentials, and risk limits
# have been explicitly configured. The KIS adapter uses the 모의투자 server while
# KIS_IS_PAPER=true; the live server additionally requires this flag and
# `tradingagents pipeline --broker kis --execute --confirm-live`.
TRADINGAGENTS_ENABLE_LIVE_TRADING=false

# Harness / forecast / audit
# naive (default, no extra deps), timesfm (pip install "tradingagents[forecast]"), or auto.
TRADINGAGENTS_FORECAST_BACKEND=naive
TRADINGAGENTS_TIMESFM_CHECKPOINT=google/timesfm-2.5-200m-pytorch
TRADINGAGENTS_TIMESFM_DEVICE=cpu
TRADINGAGENTS_TIMESFM_CONTEXT=512
# Hash-chained JSONL ledger written by `tradingagents pipeline` (default ~/.tradingagents/audit/audit.jsonl).
TRADINGAGENTS_AUDIT_LOG_PATH=
# Bounded screener universe (CSV of 6-digit codes) used when whole-market pykrx
# frames from data.krx.co.kr are blocked. Falls back to TRADINGAGENTS_SITEMAP_TICKERS.
TRADINGAGENTS_SCREENER_UNIVERSE=
# Web cron harness (always dry-run). Keep confirmer=none on Vercel; use
# playbook/debate from the CLI or GitHub Actions where LLM calls have time.
TRADINGAGENTS_HARNESS_CRON_CONFIRMER=none
TRADINGAGENTS_HARNESS_CRON_CONFIRM_TOP_N=3
TRADINGAGENTS_HARNESS_MARKETS=KOSPI,KOSDAQ

# Subscriptions (research-tool plans). PortOne V2 billing-key recurring payments.
# Leave blank to keep the site free; /pricing still renders and checkout returns 503.
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
# Standard-Webhooks secret from the PortOne console (starts with whsec_).
PORTONE_WEBHOOK_SECRET=

# Telegram notifications (harness issue push + member linking).
# Create a bot with @BotFather, then register the webhook once with
# POST /api/admin/notifications/telegram/setup (worker token).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
